{# The files in the backup folder, each with a button that deletes it (after the browser asked «really?»). Opened in a
   dialog from the «Backups» card; as a page it works the same. #}
{% extends craft.app.request.isAjax ? 'data-keeper/_dialog' : '_layouts/cp' %}
{% import 'data-keeper/_macros' as m %}
{% do view.registerAssetBundle('pixelwerft\\datakeeper\\web\\assets\\cp\\DataKeeperAsset') %}

{% set title = 'Backup files'|t('data-keeper') %}
{% set selectedSubnavItem = 'overview' %}
{% set crumbs = [{ label: 'Data Keeper'|t('data-keeper'), url: cpUrl('data-keeper') }] %}

{% block content %}
  <div class="dk">
    <p class="light">{{ 'The files that lie directly in the backup folder, newest first.'|t('data-keeper') }} <code>{{ folder }}</code></p>

    {% if files|length %}
      <table class="data fullwidth dk-files">
        <thead>
          <tr>
            <th>{{ 'File'|t('data-keeper') }}</th>
            <th>{{ 'Date'|t('data-keeper') }}</th>
            <th class="dk-num">MB</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for file in files %}
            <tr>
              <td><code>{{ file.name }}</code></td>
              <td>{{ file.mtime|datetime('short') }}</td>
              <td class="dk-num">{{ m.num(file.mb) }}</td>
              <td class="dk-num">
                <form method="post" accept-charset="UTF-8" onsubmit="return confirm('{{ 'Really delete «{file}»? This cannot be undone.'|t('data-keeper', { file: file.name })|e('js') }}');">
                  {{ csrfInput() }}
                  {{ actionInput('data-keeper/maintenance/delete-backup') }}
                  <input type="hidden" name="file" value="{{ file.name }}">
                  <button type="submit" class="btn small" data-icon="trash" title="{{ 'Delete'|t('data-keeper') }}" aria-label="{{ 'Delete «{file}»'|t('data-keeper', { file: file.name }) }}"></button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="2">{{ 'Sum'|t('data-keeper') }}</th>
            <td class="dk-num">{{ m.num(files|reduce((sum, f) => sum + f.mb, 0)|round(1)) }}</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    {% else %}
      <p class="dk-note">{{ 'There are no files in the backup folder.'|t('data-keeper') }}</p>
    {% endif %}
  </div>
{% endblock %}
