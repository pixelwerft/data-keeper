{# The overview: the last measurement with a level per key figure and its change since the one before, the largest
   tables, the folders, the entries with the most saved versions, the relevant Craft settings and the course. #}
{% extends '_layouts/cp' %}
{% import 'data-keeper/_macros' as m %}
{% do view.registerAssetBundle('pixelwerft\\datakeeper\\web\\assets\\cp\\DataKeeperAsset') %}

{% set title = 'Data Keeper'|t('data-keeper') %}
{% set selectedSubnavItem = 'overview' %}
{# two tabs; Craft shows the container a tab points to and hides the others #}
{% set tabs = {
  overview: { label: 'Overview'|t('data-keeper'), url: '#dk-overview' },
  infos: { label: 'Information'|t('data-keeper'), url: '#dk-infos' },
} %}

{# the name stays the same in every language; the line below it says what the section is #}
{% block pageTitle %}
  {{ parent() }}
  <p class="dk-claim">{{ 'Data housekeeping overview'|t('data-keeper') }}</p>
{% endblock %}

{% block content %}
  <div class="dk">
  <div id="dk-overview">
    {{ m.minimisation() }}

    <p class="dk-lead">{{ 'How much the site stores and how fast it grows. It is only measured when you click «Measure now» (or when the console command or the queue job runs). The measurements are kept in a small file in storage/data-keeper, not in the database.'|t('data-keeper') }}</p>

    <div class="dk-actions">
      {% if canMeasure %}
        <form method="post" accept-charset="UTF-8">
          {{ csrfInput() }}
          {{ actionInput('data-keeper/default/measure') }}
          <button type="submit" class="btn submit">{{ 'Measure now'|t('data-keeper') }}</button>
        </form>
      {% endif %}
      {% if measured %}
        <span class="light">
          {{ 'Measured on {date}'|t('data-keeper', { date: measuredAt|datetime('short') }) }}
          {%- if growth.since %} · {{ 'compared with the measurement of {date}'|t('data-keeper', { date: growth.since|date('short') }) }}{% endif %}
        </span>
      {% endif %}
    </div>

    {% if conditions|length %}
      <section class="dk-attention" aria-labelledby="dk-attention-title">
        <h2 id="dk-attention-title">{{ 'Needs attention'|t('data-keeper') }}</h2>
        <ul>
          {% for c in conditions %}
            <li class="dk-attention-{{ c.level }}"><strong>{{ c.title }}</strong> <span class="light">{{ c.message }}</span></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if currentUser.admin %}
      <form method="post" accept-charset="UTF-8" class="dk-test">
        {{ csrfInput() }}
        {{ actionInput('data-keeper/default/test-notification') }}
        {{ redirectInput('data-keeper') }}
        <button type="submit" class="btn small">{{ 'Send test message'|t('data-keeper') }}</button>
        <span class="light">{{ 'Sends a message through the e-mail and webhook channels that are switched on in the settings.'|t('data-keeper') }}</span>
      </form>
    {% endif %}

    {% if not measured %}
      <p>{{ 'Not measured yet. Measuring takes a few seconds.'|t('data-keeper') }}</p>
    {% else %}

    <ul class="dk-cards">
      {% for key, limit in limits %}
        {% set value = figures[key] %}
        {% set level = levels[key] %}
        {% set unit = limit.unit ? ' ' ~ limit.unit : '' %}
        <li class="dk-card dk-card-{{ level }}">
          <span class="dk-card-head">
            {# decorative: the label next to it says what the figure is #}
            <span class="dk-icon" aria-hidden="true">{{ svg('@pixelwerft/datakeeper/icons/' ~ limit.icon ~ '.svg') }}</span>
            <span class="dk-label">{{ limit.label|t('data-keeper') }}</span>
          </span>
          <strong class="dk-value">{{ m.num(value) }}{% if limit.unit %} <small>{{ limit.unit }}</small>{% endif %}</strong>
          <span class="dk-level">{{ m.level(level) }}</span>
          <span class="dk-growth">
            {% set g = growth.values[key] ?? null %}
            {% if g is not null %}
              {{ '{change} since {date}'|t('data-keeper', { change: (g >= 0 ? '+' : '') ~ g|number(g == g|round ? 0 : 1), date: growth.since|date('short') }) }}
            {% else %}
              {{ 'No earlier measurement yet'|t('data-keeper') }}
            {% endif %}
          </span>
          <span class="dk-limit light">{{ 'Keep an eye on it from {warn}, act from {alert}{unit}'|t('data-keeper', { warn: m.num(limit.warn), alert: m.num(limit.alert), unit: unit }) }}</span>
          {% if cardActions[key] is defined %}
            {# each leads to a page that says what the action would do; nothing happens by clicking here #}
            <span class="dk-card-actions">
              {% for cardAction in cardActions[key] %}<a class="btn small" href="{{ cpUrl('data-keeper/action/' ~ cardAction.id) }}" data-dk-dialog data-dk-close="{{ 'Close'|t('data-keeper') }}">{{ cardAction.button }}</a>{% endfor %}
            </span>
          {% elseif key == 'backups' and canCleanup %}
            <span class="dk-card-actions">
              <a class="btn small" href="{{ cpUrl('data-keeper/backups') }}" data-dk-dialog data-dk-name="backups" data-dk-close="{{ 'Close'|t('data-keeper') }}">{{ 'Files…'|t('data-keeper') }}</a>
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if versionAge is defined and figures.revisions > 0 %}
      <p class="dk-note">{{ 'Of the saved versions, {a} are older than a year and {b} older than two years.'|t('data-keeper', { a: m.num(versionAge.year1), b: m.num(versionAge.year2) }) }}
        {% if canCleanup %}<a href="{{ cpUrl('data-keeper/cleanup') }}">{{ 'See what the cleanup would remove'|t('data-keeper') }}</a>{% endif %}</p>
    {% endif %}

    <div class="dk-grid">
      <section>
        <h2>{{ 'Database tables (by size)'|t('data-keeper') }}</h2>
        {% if tables|length %}
          <table class="data fullwidth">
            <thead><tr><th>{{ 'Table'|t('data-keeper') }}</th><th>{{ 'Content'|t('data-keeper') }}</th><th class="dk-num">{{ 'Rows'|t('data-keeper') }}</th><th class="dk-num">MB</th></tr></thead>
            <tbody>
              {% for t in tables %}
                <tr><td><code>{{ t.name }}</code></td><td class="light">{{ tableNotes[t.name] ?? '' }}</td><td class="dk-num">{{ m.num(t.rows) }}</td><td class="dk-num">{{ m.num(t.mb) }}</td></tr>
              {% endfor %}
            </tbody>
            {# the list holds the largest tables only; where the measurement has it, the sum of all tables follows #}
            {% set allListed = tablesTotal is defined and tablesTotal.count <= tables|length %}
            <tfoot>
              <tr>
                <th scope="row" colspan="2">{{ allListed ? 'Sum'|t('data-keeper') : 'Sum of the tables listed'|t('data-keeper') }}</th>
                <td class="dk-num">{{ m.num(tables|reduce((sum, t) => sum + t.rows, 0)) }}</td>
                <td class="dk-num">{{ m.num(tables|reduce((sum, t) => sum + t.mb, 0)|round(1)) }}</td>
              </tr>
              {% if tablesTotal is defined and not allListed %}
                <tr>
                  <th scope="row" colspan="2">{{ 'All {n} tables'|t('data-keeper', { n: tablesTotal.count }) }}</th>
                  <td class="dk-num">{{ m.num(tablesTotal.rows) }}</td>
                  <td class="dk-num">{{ m.num(tablesTotal.mb) }}</td>
                </tr>
              {% endif %}
            </tfoot>
          </table>
          <p class="light">{{ 'Row counts are estimates of the database.'|t('data-keeper') }}</p>
        {% else %}
          <p class="light">{{ 'Table sizes are only read for MySQL, MariaDB and PostgreSQL.'|t('data-keeper') }}</p>
        {% endif %}
      </section>

      <section>
        <h2>{{ 'File storage'|t('data-keeper') }}</h2>
        <table class="data fullwidth">
          <thead><tr><th>{{ 'Folder'|t('data-keeper') }}</th><th class="dk-num">{{ 'Files'|t('data-keeper') }}</th><th class="dk-num">MB</th><th>{{ 'Oldest – newest'|t('data-keeper') }}</th></tr></thead>
          <tbody>
            {% for f in folders %}
              <tr>
                <td>{{ f.label|t('data-keeper', { name: f.name }) }}<br><code class="light">{{ f.path }}</code></td>
                <td class="dk-num">{{ m.num(f.files) }}</td>
                <td class="dk-num">{{ m.num(f.mb) }}</td>
                <td class="light">{{ f.oldest ? m.day(f.oldest) ~ ' – ' ~ m.day(f.newest) : '–' }}</td>
              </tr>
            {% endfor %}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">{{ 'Sum'|t('data-keeper') }}</th>
              <td class="dk-num">{{ m.num(folders|reduce((sum, f) => sum + f.files, 0)) }}</td>
              <td class="dk-num">{{ m.num(folders|reduce((sum, f) => sum + f.mb, 0)|round(1)) }}</td>
              <td></td>
            </tr>
          </tfoot>
        </table>

        <h2>{{ 'Most saved versions'|t('data-keeper') }}</h2>
        {% if topRevisions|length %}
          <table class="data fullwidth">
            <thead><tr><th>{{ 'Entry'|t('data-keeper') }}</th><th class="dk-num">{{ 'Versions'|t('data-keeper') }}</th>{% if canCleanup %}<th></th>{% endif %}</tr></thead>
            <tbody>
              {% for r in topRevisions %}
                <tr>
                  <td>{% if r.url %}<a href="{{ r.url }}">{{ r.title ?: '#' ~ r.canonicalId }}</a>{% else %}{{ r.title ?: '#' ~ r.canonicalId }}{% endif %}</td>
                  <td class="dk-num">{{ m.num(r.n) }}</td>
                  {% if canCleanup %}<td class="dk-num"><a class="btn small" href="{{ cpUrl('data-keeper/versions/' ~ r.canonicalId) }}" data-dk-dialog data-dk-close="{{ 'Close'|t('data-keeper') }}">{{ 'Clear versions…'|t('data-keeper') }}</a></td>{% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="light">{{ 'No saved versions.'|t('data-keeper') }}</p>
        {% endif %}

        <h2>{{ 'Craft settings'|t('data-keeper') }}</h2>
        <table class="data fullwidth">
          <tbody>
            <tr><td>{{ 'Versions per entry'|t('data-keeper') }} (<code>maxRevisions</code>)</td><td>{{ config.maxRevisions ? 'at most {n}'|t('data-keeper', { n: config.maxRevisions }) : 'unlimited'|t('data-keeper') }}</td></tr>
            <tr><td>{{ 'Remove deleted items for good after'|t('data-keeper') }} (<code>softDeleteDuration</code>)</td><td>{{ config.softDeleteDuration ? '{n} days'|t('data-keeper', { n: (config.softDeleteDuration / 86400)|round }) : 'never'|t('data-keeper') }}</td></tr>
            <tr><td>{{ 'Backup before every update'|t('data-keeper') }} (<code>backupOnUpdate</code>)</td><td>{% if not config.backupOnUpdate %}{{ 'no'|t('data-keeper') }}{% elseif config.maxBackups ?? false %}{{ 'yes – Craft keeps the newest {n} backups'|t('data-keeper', { n: config.maxBackups }) }} (<code>maxBackups</code>){% else %}{{ 'yes – backups are not deleted automatically'|t('data-keeper') }}{% endif %}</td></tr>
          </tbody>
        </table>
      </section>
    </div>

    {% if lastActions|length %}
      <section>
        <h2>{{ 'Last actions'|t('data-keeper') }}</h2>
        <table class="data fullwidth">
          <thead><tr><th>{{ 'Date'|t('data-keeper') }}</th><th>{{ 'Action'|t('data-keeper') }}</th><th>{{ 'Result'|t('data-keeper') }}</th></tr></thead>
          <tbody>
            {% for done in lastActions %}
              <tr>
                <td>{{ done.at|datetime('short') }}</td>
                <td>{{ done.label }}</td>
                <td>
                  {% if done.ok %}{{ done.text }}{% else %}<span class="error">{{ done.text }}</span>{% endif %}
                  {% if done.problems|length %}
                    <ul class="dk-plain">{% for problem in done.problems %}<li><code>{{ problem }}</code></li>{% endfor %}</ul>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    {% endif %}

    <section>
      <h2>{{ 'Course (last measurement of each month)'|t('data-keeper') }}</h2>
      {% if history|length %}
        <table class="data fullwidth">
          <thead><tr><th>{{ 'Date'|t('data-keeper') }}</th><th class="dk-num">{{ 'Database MB'|t('data-keeper') }}</th><th class="dk-num">{{ 'Versions'|t('data-keeper') }}</th><th class="dk-num">{{ 'Backups MB'|t('data-keeper') }}</th><th class="dk-num">{{ 'Logs MB'|t('data-keeper') }}</th><th class="dk-num">{{ 'Files MB'|t('data-keeper') }}</th></tr></thead>
          <tbody>
            {% for row in history %}
              <tr><td>{{ row.date|date('short') }}</td><td class="dk-num">{{ m.num(row.database) }}</td><td class="dk-num">{{ m.num(row.revisions) }}</td><td class="dk-num">{{ m.num(row.backups) }}</td><td class="dk-num">{{ m.num(row.logs) }}</td><td class="dk-num">{{ m.num(row.files ?? 0) }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="light">{{ 'No measurements yet.'|t('data-keeper') }}</p>
      {% endif %}
    </section>

    {% endif %}
  </div>

  {# about the installation the figures come from; read when the page is opened, not part of a measurement #}
  <div id="dk-infos" class="hidden">
    <h2>{{ 'Installation'|t('data-keeper') }}</h2>
    <table class="data fullwidth dk-info">
      <tbody>
        <tr><th scope="row">Data Keeper</th><td>{{ info.plugin }}</td></tr>
        <tr><th scope="row">Craft CMS</th><td>{{ info.craft }}</td></tr>
        <tr><th scope="row">PHP</th><td>{{ info.php }}</td></tr>
        <tr><th scope="row">{{ 'Database'|t('data-keeper') }}</th><td>{{ info.database }}</td></tr>
        <tr><th scope="row">{{ 'Table prefix'|t('data-keeper') }}</th><td>{% if info.tablePrefix %}<code>{{ info.tablePrefix }}</code>{% else %}{{ 'none'|t('data-keeper') }}{% endif %}</td></tr>
        <tr><th scope="row">{{ 'Environment'|t('data-keeper') }}</th><td>{{ info.environment ?: '–' }}</td></tr>
        <tr><th scope="row">{{ 'Dev mode'|t('data-keeper') }}</th><td>{{ info.devMode ? 'yes'|t('data-keeper') : 'no'|t('data-keeper') }}</td></tr>
        <tr><th scope="row">{{ 'Time zone'|t('data-keeper') }}</th><td>{{ info.timeZone }}</td></tr>
        <tr><th scope="row">{{ 'Measurements file'|t('data-keeper') }}</th><td><code>{{ info.storeFile }}</code></td></tr>
        <tr><th scope="row">{{ 'Last measurement'|t('data-keeper') }}</th><td>{{ measured ? measuredAt|datetime('short') : 'Never measured'|t('data-keeper') }}</td></tr>
      </tbody>
    </table>

    {# admins only: the key of the site and where a tool outside asks for the figures #}
    {% if remote %}
      {% import '_includes/forms' as forms %}
      <section class="dk-remote">
        <h2>{{ 'Remote queries'|t('data-keeper') }}</h2>
        <p class="light">{{ 'A tool outside the site can ask for the figures of the overview as JSON – a dashboard that watches several sites, for example. Access needs the key below.'|t('data-keeper') }}</p>
        <p>
          {% if remote.enabled %}
            <span class="dk-state dk-state-on">{{ 'Allowed'|t('data-keeper') }}</span>
          {% else %}
            <span class="dk-state">{{ 'Not allowed'|t('data-keeper') }}</span>
            {{ 'Switch on «Allow remote queries» in the settings; until then the key opens nothing.'|t('data-keeper') }}
            <a href="{{ cpUrl('settings/plugins/data-keeper') }}">{{ 'Open the settings'|t('data-keeper') }}</a>
          {% endif %}
        </p>
        {% if remote.key == '' %}
          <p class="error">{{ 'The key could not be stored. Check that the storage folder is writable.'|t('data-keeper') }}</p>
        {% else %}
          {{ forms.copytextField({
            label: 'Key'|t('data-keeper'),
            instructions: remote.createdAt ? 'generated on {date}'|t('data-keeper', { date: remote.createdAt|datetime('short') }) : null,
            id: 'dk-remote-key', class: 'code', value: remote.key, size: 56,
          }) }}
          {{ forms.copytextField({
            label: 'Address'|t('data-keeper'),
            id: 'dk-remote-url', class: 'code', value: remote.url, size: 72,
          }) }}
          {{ forms.copytextField({
            label: 'Example'|t('data-keeper'),
            id: 'dk-remote-example', class: 'code', size: 72,
            value: 'curl -H "Authorization: Bearer ' ~ remote.key ~ '" "' ~ remote.url ~ '"',
          }) }}
          <form method="post" accept-charset="UTF-8" class="dk-actions">
            {{ csrfInput() }}
            {{ actionInput('data-keeper/default/reset-remote-key') }}
            <button type="button" class="btn small formsubmit" data-confirm="{{ 'Generate a new key? The current one stops working at once; every tool that uses it needs the new one.'|t('data-keeper') }}">{{ 'Generate a new key'|t('data-keeper') }}</button>
            <span class="light">{{ 'The key is kept in the plugin’s file in storage, not in the project config. Treat it like a password.'|t('data-keeper') }}</span>
          </form>
        {% endif %}
      </section>
    {% endif %}
  </div>
  </div>
{% endblock %}
