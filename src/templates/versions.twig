{# Clear the saved versions of one element: shows how many would go before anything is deleted. #}
{% extends '_layouts/cp' %}
{% import 'data-keeper/_macros' as m %}
{% do view.registerAssetBundle('pixelwerft\\datakeeper\\web\\assets\\cp\\DataKeeperAsset') %}

{% set title = 'Clear saved versions'|t('data-keeper') %}
{% set selectedSubnavItem = 'overview' %}
{% set crumbs = [{ label: 'Data Keeper', url: cpUrl('data-keeper') }] %}

{% block content %}
  <div class="dk">
    <h2>{% if element %}<a href="{{ element.cpEditUrl }}">{{ element }}</a>{% else %}#{{ canonicalId }}{% endif %}</h2>
    <p>{{ 'This entry has {n} saved versions.'|t('data-keeper', { n: total }) }}</p>

    <form method="get" accept-charset="UTF-8" class="dk-options">
      <div class="dk-inline">
        <label for="dk-keep">{{ 'Keep the newest'|t('data-keeper') }}</label>
        <input type="number" id="dk-keep" name="keep" value="{{ keep }}" min="0" max="{{ total }}" class="text">
        <span>{{ 'versions'|t('data-keeper') }}</span>
      </div>
      <label class="dk-check"><input type="checkbox" name="keepFirst" value="1"{{ keepFirst ? ' checked' }}> {{ 'Also keep the very first version'|t('data-keeper') }}</label>
      <div class="dk-inline">
        <label for="dk-days">{{ 'Only delete versions older than (days, 0: any age)'|t('data-keeper') }}</label>
        <input type="number" id="dk-days" name="days" value="{{ days }}" min="0" class="text">
      </div>
      <button type="submit" class="btn">{{ 'Update'|t('data-keeper') }}</button>
    </form>

    {% if toDelete == 0 %}
      <p class="dk-note">{{ 'Nothing to delete with these options.'|t('data-keeper') }}</p>
    {% else %}
      <form method="post" accept-charset="UTF-8" class="dk-run">
        {{ csrfInput() }}
        {{ actionInput('data-keeper/default/clear-versions') }}
        <input type="hidden" name="canonicalId" value="{{ canonicalId }}">
        <input type="hidden" name="keep" value="{{ keep }}">
        <input type="hidden" name="keepFirst" value="{{ keepFirst ? 1 : 0 }}">
        <input type="hidden" name="days" value="{{ days }}">
        <input type="hidden" name="confirmedCount" value="{{ toDelete }}">
        <p>{{ '{delete} of {total} saved versions will be permanently deleted. The newest {keep} stay.'|t('data-keeper', { delete: toDelete, total: total, keep: keep }) }}
          {% if keepFirst %}{{ 'The very first version stays as well.'|t('data-keeper') }}{% endif %}
          {% if days %}{{ 'Only versions older than {n} days are deleted.'|t('data-keeper', { n: days }) }}{% endif %}
          {{ 'The entry itself and its current content are not changed. Deleted versions can no longer be restored.'|t('data-keeper') }}</p>
        <label class="dk-check"><input type="checkbox" required> {{ 'I understand that this is permanent.'|t('data-keeper') }}</label>
        <button type="submit" class="btn submit">{{ 'Delete {n} saved versions'|t('data-keeper', { n: toDelete }) }}</button>
      </form>
    {% endif %}
  </div>
{% endblock %}
